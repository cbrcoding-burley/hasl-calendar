# Copy to production.tfvars and fill in non-sensitive values.
# Never commit production.tfvars (it's in .gitignore).

github_owner  = "christianreynolds"
github_repo   = "hasl-calendar"
deploy_branch = "main"

# Provider tokens — set as native env vars (no TF_VAR_ prefix needed):
#   export RAILWAY_TOKEN="..."   # Railway account token (Settings → Tokens)
#   export GITHUB_TOKEN="ghp_..." # PAT with repo + secrets scopes

# Keypairs and CI token — set as TF_VAR_* since they're written into Railway/GitHub:
#   export TF_VAR_sync_public_key="$(cat ../.secrets/public_key.pem)"
#   export TF_VAR_sync_private_key="$(cat ../.secrets/private_key.pem)"
#   export TF_VAR_railway_ci_token="..."  # generate in Railway dashboard → project → Settings → Tokens (environment-scoped)
