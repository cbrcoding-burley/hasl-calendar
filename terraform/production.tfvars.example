# Copy to terraform.tfvars (or pass values as env vars) and fill in.
# Never commit a file containing real values — it's in .gitignore.

github_owner = "christianreynolds"
github_repo  = "hasl-calendar"

# Railway auto-creates a "production" environment on project creation.
# Get the ID from Railway dashboard → project Settings → Environments,
# then set TF_VAR_existing_production_environment_id so Terraform imports
# it instead of trying to create it. Leave empty for a brand-new project.
#
# existing_production_environment_id = ""

# Optional: enable custom domain + Cloudflare DNS management.
# root_domain = "hasl.example.com"

# Sensitive values — always set as env vars, never in this file:
#
#   export TF_VAR_railway_token="..."          # Railway → Settings → Tokens
#   export TF_VAR_sync_public_key="$(cat ../.secrets/public_key.pem)"
#   export TF_VAR_sync_private_key="$(cat ../.secrets/private_key.pem)"
#
# If using Cloudflare:
#   export TF_VAR_cloudflare_zone_id="..."
#   export TF_VAR_cloudflare_api_token="..."   # needs Edit Zone DNS permission
